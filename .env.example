# Development only. Generate distinct high-entropy values before any deployment.
NODE_ENV=development
PORT=3000
DATABASE_URL=file:./warren.db
AUTH_DOMAIN=localhost
AUTH_URI=http://localhost:3000
CHALLENGE_TTL_SECONDS=900
ATTEMPT_TTL_SECONDS=1200
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
SESSION_HMAC_PEPPER=change-this-development-only-pepper-before-production
SESSION_RESULT_ENCRYPTION_KEY=change-this-development-only-result-encryption-key
EVM_SUPPORTED_CHAIN_IDS=1
SOLANA_SUPPORTED_CLUSTERS=devnet
CORS_ORIGINS=http://localhost:8081
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# Server-only Home data providers. Never expose these through EXPO_PUBLIC_* variables.
TOKENS_API_BASE_URL=https://api.tokens.xyz
TOKENS_API_KEY=
HOME_PROVIDER_TIMEOUT_MS=5000
HOME_CATALOG_CACHE_SECONDS=60
HOME_CATALOG_STALE_SECONDS=900
HOME_HTTP_CACHE_SECONDS=15
HOME_HTTP_STALE_SECONDS=60

# Read-only Markets providers.
PRESTOCKS_API_URL=https://prestocks.com/api/prestocks
PHOENIX_API_BASE_URL=https://perp-api.phoenix.trade
# Optional. When set, Warren uses Phoenix's wallet-signed referral activation
# transaction. Leave unset to use builder registration without a referral.
PHOENIX_REFERRAL_CODE=
MARKETS_PROVIDER_TIMEOUT_MS=8000
MARKETS_REGISTRY_CACHE_SECONDS=60
MARKETS_REGISTRY_STALE_SECONDS=900
MARKETS_HTTP_CACHE_SECONDS=15
MARKETS_HTTP_STALE_SECONDS=60

# Kamino xStocks catalog and transaction provider. Risk/recovery action flags
# remain off until operational and device release gates are approved.
KAMINO_API_BASE_URL=https://api.kamino.finance
KAMINO_MARKET_TIMEOUT_MS=8000
KAMINO_LENDING_ENABLED=true
KAMINO_LENDING_NEW_RISK_ENABLED=false
KAMINO_LENDING_REPAY_ENABLED=false
KAMINO_LENDING_WITHDRAW_ENABLED=false
# Warren uses this share of the SDK-computed remaining borrow headroom; tune only
# after product and risk review. The SDK remains the source of all protocol math.
KAMINO_BORROW_HEADROOM_BPS=5000

# Server-only execution configuration. PRIVY_APP_SECRET and JUPITER_API_KEY must
# never be placed in the mobile app or any EXPO_PUBLIC_* variable.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
JUPITER_API_BASE_URL=https://api.jup.ag
JUPITER_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_RPC_URL=
EXECUTION_PROVIDER_TIMEOUT_MS=12000
EXECUTION_INTENT_TTL_SECONDS=90
