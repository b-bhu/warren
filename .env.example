# Development only. Generate distinct high-entropy values before any deployment.
NODE_ENV=development
PORT=3000
DATABASE_URL=file:./warren.db
AUTH_DOMAIN=localhost
AUTH_URI=http://localhost:3000
CHALLENGE_TTL_SECONDS=900
ATTEMPT_TTL_SECONDS=1200
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
SESSION_HMAC_PEPPER=change-this-development-only-pepper-before-production
SESSION_RESULT_ENCRYPTION_KEY=change-this-development-only-result-encryption-key
EVM_SUPPORTED_CHAIN_IDS=1
SOLANA_SUPPORTED_CLUSTERS=devnet
CORS_ORIGINS=http://localhost:8081
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# Server-only Home data providers. Never expose these through EXPO_PUBLIC_* variables.
TOKENS_API_BASE_URL=https://api.tokens.xyz
TOKENS_API_KEY=
HOME_PROVIDER_TIMEOUT_MS=5000
HOME_CATALOG_CACHE_SECONDS=60
HOME_CATALOG_STALE_SECONDS=900
HOME_HTTP_CACHE_SECONDS=15
HOME_HTTP_STALE_SECONDS=60
