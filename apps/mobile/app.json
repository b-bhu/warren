{
  "expo": {
    "name": "Warren",
    "slug": "warren",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/warren-icon-v1.png",
    "scheme": "warren",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/warren-icon-v1.png",
      "bundleIdentifier": "com.warren.app"
    },
    "android": {
      "package": "com.warren.app",
      "adaptiveIcon": {
        "backgroundColor": "#131918",
        "foregroundImage": "./assets/images/warren-android-foreground-v1.png",
        "backgroundImage": "./assets/images/warren-android-background-v1.png",
        "monochromeImage": "./assets/images/warren-android-monochrome-v1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/warren-favicon-v1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131918",
          "image": "./assets/images/warren-splash-v1.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
