# Public identifiers from Privy Dashboard > App settings > Clients.
# These are safe to bundle. Never put a Privy app secret in EXPO_PUBLIC_*.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Public legal pages: optional for local UI work, required in production.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
